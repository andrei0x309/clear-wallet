{
  "name": "clear-wallet",
  "version": "1.5.5",
  "private": true,
  "description": "Clear Wallet (CLW) is a wallet that helps you manage your Ethereum assets and interact with Ethereum dApps and contracts with the main focus on absolute privacy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "inject": "bun build src/extension/inject.ts --minify --target=browser --format iife --outdir ./src/extension/",
    "content": "bun build src/extension/content.ts --minify --target=browser --outdir ./src/extension/",
    "post-build": "bun run ./release-scripts/post-build.ts",
    "build": "bun run inject && bun run content && vue-tsc --noEmit && vite build && bun run post-build",
    "build-firefox": "bun run inject && bun run content && vue-tsc --noEmit && vite build && bun run post-build firefox",
    "rebuild": "bun run build && bun run ./release-scripts/create-release.ts rebuild",
    "build-source": "bun run ./release-scripts/create-source-archive.ts",
    "preview": "vite preview",
    "release": "bun run ./release-scripts/version-release.ts",
    "postversion": "git push",
    "pub": "bun run build && bun run release && bun run ./release-scripts/create-release.ts",
    "only-pub": "bun run build && bun run ./release-scripts/create-release.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@ionic/core": "^9.0.6",
    "@ionic/vue": "^9.0.6",
    "@ionic/vue-router": "^9.0.6",
    "core-js": "^3.50.0",
    "ethers": "^6.17.0",
    "jsqr": "^1.4.0",
    "p-queue": "9.3.3",
    "vue": "^3.5.43",
    "vue-router": "5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/archiver": "8.0.0",
    "@types/bun": "^1.4.2",
    "@types/chrome": "latest",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "archiver": "8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "latest",
    "eslint-plugin-vue": "^10.11.1",
    "http-browserify": "^1.7.0",
    "https-browserify": "^1.0.0",
    "jest": "^30.5.2",
    "sass": "^1.105.1",
    "stream-browserify": "^3.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "vite": "latest",
    "vue-tsc": "^3.3.12"
  },
  "disabledNativeDependencies": {
    "@capacitor/app": "^5.0.6",
    "@capacitor/core": "^5.2.3",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6"
  }
}